# Copy this file to .env.local and fill in real values.

# The site's real production URL — used for canonical links, OpenGraph/
# Twitter absolute image URLs, sitemap.xml, and robots.txt (src/constants/
# site.ts, app/sitemap.ts, app/robots.ts, app/layout.tsx's metadataBase).
# Defaults to a lorius.id placeholder if unset; set this to the real
# domain before deploying, or SEO tags will point at the wrong host.
NEXT_PUBLIC_SITE_URL=https://lorius.id

# Google Analytics 4 Measurement ID (starts with "G-"), from
# analytics.google.com. Without this set, no analytics script is loaded
# at all (src/components/analytics/google-analytics.tsx) — no fake/blank
# tracking ID is ever injected — and src/lib/analytics.ts's trackEvent()
# calls silently no-op instead of erroring.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
